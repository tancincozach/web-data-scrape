# Copy this file to .env and replace the placeholder secrets before running
# Docker Compose. Never commit the resulting .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=web,localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
SCALAR_TITLE=Web Data Scrape API

POSTGRES_DB=web_scrape
POSTGRES_USER=web_scrape
POSTGRES_PASSWORD=replace-with-a-strong-password
# Docker Compose overrides the host/port to the db service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

SCRAPE_THROTTLE_RATE=60/min
RUN_MIGRATIONS=1
WEB_PORT=8080
